DATABASE_URL=postgresql://rideshare:rideshare@localhost:5432/rideshare
DIRECT_URL=postgresql://rideshare:rideshare@localhost:5432/rideshare
DATABASE_URL_TEST=postgresql://rideshare:rideshare@localhost:5432/rideshare_test
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Geo: "live" (Photon + OSRM, default) or "fake" (offline; tests and CI)
GEO_PROVIDER=
# Map tiles: "on" (default) or "off" (no external tile requests; e2e and CI)
NEXT_PUBLIC_MAP_TILES=
# Scratch database for `npm run db:drift` (it is wiped)
SHADOW_DATABASE_URL=postgresql://rideshare:rideshare@localhost:5432/rideshare_shadow
